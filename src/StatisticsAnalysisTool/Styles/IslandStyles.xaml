<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations"
                    xmlns:island="clr-namespace:StatisticsAnalysisTool.Island"
                    xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
                    xmlns:enum="clr-namespace:StatisticsAnalysisTool.Enumerations">

    <!-- ===== Laborer status brushes ===== -->

    <SolidColorBrush x:Key="Island.Status.LootReady.Brush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="Island.Status.OnJob.Brush" Color="#2196F3"/>
    <SolidColorBrush x:Key="Island.Status.Home.Brush" Color="#757575"/>
    <SolidColorBrush x:Key="Island.PlotChip.Foreground.Brush" Color="#1A1A1A"/>

    <!-- ===== Stat tile ===== -->

    <Style x:Key="Island.Stat.Tile" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="55"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <Style x:Key="Island.Stat.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
    </Style>

    <Style x:Key="Island.Stat.Value" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}"/>
    </Style>

    <Style x:Key="Island.Stat.Value.Positive" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Island.Stat.Value}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/>
    </Style>

    <Style x:Key="Island.Stat.Value.Warning" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Island.Stat.Value}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
    </Style>

    <Style x:Key="Island.Stat.Value.Danger" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Island.Stat.Value}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}"/>
    </Style>

    <!-- ===== Section header ===== -->

    <Style x:Key="Island.Section.Header" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>

    <!-- ===== Settings panel ===== -->

    <Style x:Key="Island.Settings.Row" TargetType="{x:Type DockPanel}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Island.Settings.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Island.Settings.SubLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Island.Card.Template and Island.Plot.Template are defined in IslandManagementControl.xaml
         because they contain event handler references (MouseMove, MouseLeftButtonUp) which
         require a code-behind context and cannot live in a standalone ResourceDictionary. -->

    <!-- ===== Live laborer action row template ===== -->

    <DataTemplate x:Key="Island.LiveLaborer.ActionRow.Template">
        <Border Padding="4,3" Margin="0,0,0,1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Red.7}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Red.3}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]', FallbackValue='[12:04:31]'}"
                           Foreground="{StaticResource SolidColorBrush.Text.3}"
                           FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name, FallbackValue='Bob Smith'}"
                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                           FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <fa5:ImageAwesome Icon="Solid_ExclamationTriangle"
                                  Foreground="{StaticResource SolidColorBrush.Accent.Red.3}"
                                  Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Visibility="{Binding NeedsAttention, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBlock Text="{Binding Action, FallbackValue='Loot Ready'}"
                           Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"
                           FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail, FallbackValue='T5 Nourishing Salad x4'}"
                           Foreground="{StaticResource SolidColorBrush.Text.4}"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Live summary segment template ===== -->

    <DataTemplate x:Key="Island.LiveSummary.Segment.Template">
        <Border Padding="10,4" Margin="0,0,2,0" CornerRadius="1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.4}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Category}" Value="Idle">
                            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Category}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Red.7}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Text, FallbackValue='Idle: 4'}" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Category}" Value="Idle">
                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Warning">
                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </DataTemplate>

    <!-- ===== Yield item icon tile (80x80) ===== -->

    <DataTemplate x:Key="IslandYieldItemTemplate" DataType="{x:Type island:IslandYieldEntry}">
        <Grid Height="80" Width="80" Margin="1" ToolTip="{Binding Item.LocalizedName, IsAsync=True, Mode=OneWay}">
            <Image Source="{Binding Item.Icon, IsAsync=True, Mode=OneWay}" Stretch="Fill" />
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#c0000000" Padding="2,0">
                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#c0000000" Padding="2,0">
                <TextBlock Text="{Binding Item.TierLevelString, IsAsync=True, Mode=OneWay, FallbackValue=''}"
                           Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="9" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IslandConsumedItemTemplate" DataType="{x:Type island:IslandConsumedEntry}">
        <Grid Height="80" Width="80" Margin="1" ToolTip="{Binding Item.LocalizedName, IsAsync=True, Mode=OneWay}">
            <Image Source="{Binding Item.Icon, IsAsync=True, Mode=OneWay}" Stretch="Fill" />
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#c0000000" Padding="2,0">
                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#c0000000" Padding="2,0">
                <TextBlock Text="{Binding Item.TierLevelString, IsAsync=True, Mode=OneWay, FallbackValue=''}"
                           Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="9" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IslandYieldAggregateRowTemplate" DataType="{x:Type island:IslandYieldAggregateRow}">
        <Border Style="{StaticResource Container.Border}" Margin="0,1">
            <DockPanel Height="44" Margin="4,2">
                <Grid Width="44" Height="44" Margin="0,0,6,0">
                    <Image Source="{Binding Item.Icon, IsAsync=True, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.LocalizedName, IsAsync=True, Mode=OneWay, FallbackValue='...'}"
                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontWeight="SemiBold" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0:N0}x', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                   Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TotalAvgEstMarketValue, IsAsync=True, Mode=OneWay, StringFormat='{}{0:N0}', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding IslandName, FallbackValue=''}" Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IslandName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IslandName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
