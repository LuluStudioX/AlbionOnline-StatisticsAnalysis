<Window x:Class="StatisticsAnalysisTool.Views.WebhookConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:translation="clr-namespace:StatisticsAnalysisTool.Models.TranslationModel"
        mc:Ignorable="d"
        Title="Ready to Notify"
        Height="320" Width="480"
        MinHeight="300" MinWidth="440"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SolidColorBrush.Background.1}"
        FontSize="{StaticResource BaseFontSize}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid>
        <Border BorderThickness="1" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False"/>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Height="33" VerticalAlignment="Top"
              Background="{StaticResource SolidColorBrush.Background.3}"
              MouseDown="TitleBar_MouseDown">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource SolidColorBrush.Background.4}" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Margin="10,0,61,0" VerticalAlignment="Center">
                <fa5:ImageAwesome Icon="Solid_BellSlash"
                                  Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                                  Width="13" Height="13" Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmTitle}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,0,0,0" Click="CloseButton_Click"/>
        </Grid>

        <!-- Content -->
        <StackPanel Margin="18,43,18,56">

            <!-- Daily notes -->
            <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmNotesLabel}"
                       Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NotesTextBox"
                     Height="60"
                     FontSize="12"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource SolidColorBrush.Background.2}"
                     Foreground="{StaticResource SolidColorBrush.Text.1}"
                     Margin="0,0,0,14"/>

            <!-- EMV -->
            <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmEmvLabel}"
                       Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="EmvTextBox"
                     Height="28"
                     FontSize="12"
                     Background="{StaticResource SolidColorBrush.Background.2}"
                     Foreground="{StaticResource SolidColorBrush.Text.1}"
                     PreviewTextInput="EmvTextBox_PreviewTextInput"/>

        </StackPanel>

        <!-- Action bar -->
        <Grid Height="46" VerticalAlignment="Bottom"
              Background="{StaticResource SolidColorBrush.Background.3}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource SolidColorBrush.Background.4}" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Height="28" Width="100" Margin="0,0,8,0" Click="DontSendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_Times" Width="10" Height="10" Margin="0,0,5,0"
                                          Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmDontSend}"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Height="28" Width="72" Margin="0,0,8,0" Click="SendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_PaperPlane" Width="10" Height="10" Margin="0,0,5,0"
                                          Foreground="{StaticResource SolidColorBrush.Text.2}"/>
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmSend}"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Height="28" Width="130"
                        Style="{StaticResource Style.Button.Attention}"
                        Click="SaveAndSendButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_Check" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Static translation:MainWindowTranslation.IslandWebhookConfirmSaveAndSend}"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
