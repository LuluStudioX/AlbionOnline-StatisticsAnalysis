<Window x:Class="StatisticsAnalysisTool.Views.IslandPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:translation="clr-namespace:StatisticsAnalysisTool.Models.TranslationModel"
        mc:Ignorable="d"
        Title="Island Payment"
        Height="360" Width="460"
        MinHeight="340" MinWidth="420"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SolidColorBrush.Background.1}"
        FontSize="{StaticResource BaseFontSize}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid>
        <Border BorderThickness="1" BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.2}" IsHitTestVisible="False"/>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Height="33" VerticalAlignment="Top"
              Background="{StaticResource SolidColorBrush.Background.3}"
              MouseDown="TitleBar_MouseDown">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource SolidColorBrush.Background.4}" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Margin="10,0,61,0" VerticalAlignment="Center">
                <fa5:ImageAwesome Icon="Solid_Coins"
                                  Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                  Width="13" Height="13" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleBarText"
                           Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentTitle}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource WindowButtonStyle}" Content="r" Margin="-2,0,0,0" Click="CloseButton_Click"/>
        </Grid>

        <!-- Content -->
        <StackPanel Margin="18,43,18,56">

            <!-- Info row -->
            <Border Background="{StaticResource SolidColorBrush.Background.2}"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,0,0,2" Padding="10,8" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Style="{StaticResource Icon.Silver}"
                           Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TradeDescriptionText"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TradeAmountText"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"
                                   FontSize="11"/>
                    </StackPanel>
                    <fa5:ImageAwesome Grid.Column="2" Icon="Solid_QuestionCircle"
                                      Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Island selector -->
            <TextBlock x:Name="AssignToIslandLabel" Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentAssignToIsland}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="IslandComboBox" Height="28" FontSize="12" Margin="0,0,0,14"
                      Background="{StaticResource SolidColorBrush.Background.2}"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="IslandComboBox_SelectionChanged"/>

            <!-- Paid for week -->
            <TextBlock x:Name="PaidForWeekLabel" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,0,4" Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentPaidForWeek}"/>
            <DatePicker x:Name="PaidForWeekPicker" Height="28" FontSize="12" Margin="0,0,0,14"
                        Background="{StaticResource SolidColorBrush.Background.2}"
                        Foreground="{StaticResource SolidColorBrush.Text.1}"/>

            <!-- Notes -->
            <TextBlock x:Name="NotesLabel" Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentNotesOptional}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NotesTextBox" Height="28" FontSize="12"
                     Background="{StaticResource SolidColorBrush.Background.2}"
                     Foreground="{StaticResource SolidColorBrush.Text.1}"/>

        </StackPanel>

        <!-- Action bar -->
        <Grid Height="46" VerticalAlignment="Bottom"
              Background="{StaticResource SolidColorBrush.Background.3}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource SolidColorBrush.Background.4}" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Height="28" Width="80" Margin="0,0,8,0" Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_Times" Width="10" Height="10" Margin="0,0,5,0"
                                          Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                        <TextBlock x:Name="SkipText" Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentSkip}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ConfirmButton" Height="28" Width="140"
                        Style="{StaticResource Style.Button.Attention}"
                        IsEnabled="False"
                        Click="ConfirmButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa5:ImageAwesome Icon="Solid_Check" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock x:Name="RecordPaymentText" Text="{x:Static translation:MainWindowTranslation.IslandManagementPaymentRecord}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
