<UserControl x:Class="StatisticsAnalysisTool.UserControls.IslandManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:enumerations="clr-namespace:StatisticsAnalysisTool.Enumerations"
             xmlns:island="clr-namespace:StatisticsAnalysisTool.Island"
             xmlns:bindingModel="clr-namespace:StatisticsAnalysisTool.Models.BindingModel"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <UserControl.Resources>
        <!-- ===== Island card template ===== -->
        <!-- Kept here (not in IslandStyles.xaml) because MouseMove handler requires code-behind context. -->
        <DataTemplate x:Key="Island.Card.Template">
            <Border Margin="0,0,0,1" Padding="0" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsVisit}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Red.7}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.3}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- City color strip -->
                    <Border Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Default}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Caerleon}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Caerleon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Bridgewatch}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Bridgewatch}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Lymhurst}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Lymhurst}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Martlock}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Martlock}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.FortSterling}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.FortSterling}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Thetford}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Thetford}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CityFaction}" Value="{x:Static enumerations:CityFaction.Brecilien}">
                                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.City.Brecilien}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Card content -->
                    <StackPanel Grid.Column="1" Margin="6,4,4,4">
                        <StackPanel Orientation="Horizontal">
                            <!-- Drag handle (visible only in Custom sort mode) -->
                            <fa5:ImageAwesome Icon="Solid_GripVertical"
                                              Foreground="{StaticResource SolidColorBrush.Text.4}"
                                              Width="7" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                              Cursor="SizeAll"
                                              MouseMove="DragHandle_MouseMove">
                                <fa5:ImageAwesome.Style>
                                    <Style TargetType="{x:Type fa5:ImageAwesome}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IslandBindings.IsDragHandleVisible,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                                            FallbackValue=False}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa5:ImageAwesome.Style>
                            </fa5:ImageAwesome>
                            <TextBlock Text="{Binding Name, FallbackValue='My Island'}"
                                       Foreground="{StaticResource SolidColorBrush.Text.1}"
                                       FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Border Background="{StaticResource SolidColorBrush.Accent.Blue.5}"
                                    CornerRadius="2" Padding="3,1" Margin="0,0,4,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IslandBindings.Preferences.ShowTier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TierDisplay, FallbackValue='T5'}"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <fa5:ImageAwesome Icon="Solid_Star"
                                              Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                              Width="9" Height="9" VerticalAlignment="Center">
                                <fa5:ImageAwesome.Style>
                                    <Style TargetType="fa5:ImageAwesome">
                                        <Setter Property="Visibility" Value="{Binding HasPremium, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IslandBindings.Preferences.ShowPremium, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa5:ImageAwesome.Style>
                            </fa5:ImageAwesome>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding DataContext.IslandBindings.ShowIslandCityColors,
                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                         Converter={StaticResource BooleanToVisibilityConverter},
                                                         FallbackValue=Visible}">
                            <Image Style="{StaticResource Tracker.Fraction.Coin.Icon}" Margin="0,0,3,0"/>
                            <TextBlock Text="{Binding CityName, FallbackValue='Bridgewatch'}"
                                       Foreground="{StaticResource SolidColorBrush.Text.4}"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                    Visibility="{Binding DataContext.IslandBindings.ShowIslandBiome,
                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                         Converter={StaticResource BooleanToVisibilityConverter},
                                                         FallbackValue=Visible}">
                            <TextBlock Text="·" Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="10" Margin="0,0,3,0"/>
                            <TextBlock Text="{Binding Biome, FallbackValue='Forest'}"
                                       Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="10"/>
                        </StackPanel>

                        <TextBlock Margin="0,2,0,0" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Text" Value="{Binding CollectionStatusText, FallbackValue='Ready'}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CollectionStatusState}" Value="ready">
                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <!-- Rent overdue badge -->
                    <Border Grid.Column="2" CornerRadius="2" Padding="4,2" Margin="0,4,4,0"
                            Background="{StaticResource SolidColorBrush.Accent.Red.7}"
                            VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRentOverdue}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa5:ImageAwesome Icon="Solid_ExclamationCircle"
                                              Foreground="{StaticResource SolidColorBrush.Accent.Red.3}"
                                              Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.Translation.IslandManagementRentBadge,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     FallbackValue=Rent}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Plot card template ===== -->
        <!-- Kept here (not in IslandStyles.xaml) because MouseLeftButtonUp handler requires code-behind context. -->
        <DataTemplate x:Key="Island.Plot.Template">
            <Border Width="145" Height="Auto" MinHeight="100"
                    MouseLeftButtonUp="PlotItem_MouseLeftButtonUp"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Island.Stat.Tile}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.3}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding PlotType, FallbackValue='FARMING'}"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                   FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding Quantity, StringFormat=' x{0}', FallbackValue=' x4'}"
                                   Visibility="{Binding ShowQuantity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                   FontSize="11" Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding MapSlotLabel}"
                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                   FontSize="9" Margin="4,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Slot state dot (top-right) -->
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.6}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlotSentState}" Value="sent">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlotSentState}" Value="on_job">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlotSentState}" Value="loot_ready">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Slot dot matrix (non-house plots only) -->
                    <ItemsControl Margin="0,22,0,0" VerticalAlignment="Top"
                                  ItemsSource="{Binding SlotDots}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHouse}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Margin="0,0,3,3" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.5}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="home"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Laborer rows (house plots) -->
                    <StackPanel Margin="0,22,0,0" VerticalAlignment="Top"
                                Visibility="{Binding IsHouse, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Ellipse Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Laborer1IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer1IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer1IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding Laborer1Line, FallbackValue=''}"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                <TextBlock Text="{Binding Laborer1TimeRemaining}" FontSize="9"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                                           Visibility="{Binding HasLaborer1Timer,
                                               Converter={StaticResource BooleanToVisibilityConverter},
                                               FallbackValue=Collapsed}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Ellipse Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Laborer2IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer2IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer2IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding Laborer2Line, FallbackValue=''}"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                <TextBlock Text="{Binding Laborer2TimeRemaining}" FontSize="9"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                                           Visibility="{Binding HasLaborer2Timer,
                                               Converter={StaticResource BooleanToVisibilityConverter},
                                               FallbackValue=Collapsed}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,3,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Laborer3IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer3IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Laborer3IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding Laborer3Line, FallbackValue=''}"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                <TextBlock Text="{Binding Laborer3TimeRemaining}" FontSize="9"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}"
                                           Visibility="{Binding HasLaborer3Timer,
                                               Converter={StaticResource BooleanToVisibilityConverter},
                                               FallbackValue=Collapsed}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Farmable crop line + countdown (non-house plots, anchored to bottom) -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                    Visibility="{Binding HasCropIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding FarmableCropIcon}" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FarmableTypeLine, FallbackValue=''}"
                                       Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" MaxWidth="115" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlotCollectionCountdown}" FontSize="9"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                   Visibility="{Binding HasPlotCollectionCountdown,
                                       Converter={StaticResource BooleanToVisibilityConverter},
                                       FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ===== Root Layout ===== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IslandBindings.IsSettingsPanelOpen, FallbackValue=False}" Value="True">
                                <Setter Property="Height" Value="Auto"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- Row 0: Toolbar -->
        <!-- ======================================================= -->
        <Grid Grid.Row="0" Background="{StaticResource SolidColorBrush.Background.2}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,0,1,0" Padding="8,0"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource SolidColorBrush.Background.1}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa5:ImageAwesome Icon="Solid_Search" Foreground="{StaticResource SolidColorBrush.Text.4}"
                                      Width="10" Height="10" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding IslandBindings.SearchText, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                             Width="120" Height="24" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             FontSize="11"
                             Foreground="{StaticResource SolidColorBrush.Text.1}"
                             CaretBrush="{StaticResource SolidColorBrush.Text.1}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </Border>

            <!-- Spacer -->
            <Grid Grid.Column="1"/>

            <!-- Action buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <!-- Owner Overview -->
                <Button x:Name="OwnerOverviewButton"
                        Click="OwnerOverviewButton_Click"
                        Height="28" Width="28" Padding="0" Margin="0,0,4,0"
                        ToolTip="{Binding Translation.IslandManagementOwnerOverviewTooltip, FallbackValue='Owner Overview'}"
                        Background="Transparent" BorderThickness="0">
                    <fa5:ImageAwesome Icon="Solid_Users" Width="12" Height="12"
                                      Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                </Button>

                <!-- Add island -->
                <Button x:Name="AddIslandButton"
                        Click="AddIslandButton_Click"
                        Height="28" Width="28" Padding="0" Margin="0,0,4,0" ToolTip="{Binding Translation.IslandManagementAddIslandTooltip, FallbackValue='Add new island'}"
                        Background="Transparent" BorderThickness="0"
                        Visibility="{Binding IslandBindings.ShowIslandEditButtons, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}">
                    <fa5:ImageAwesome Icon="Solid_Plus" Width="11" Height="11"
                                      Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                </Button>

                <!-- Edit island -->
                <Button x:Name="EditIslandButton"
                        Click="EditIslandButton_Click"
                        Height="28" Width="28" Padding="0" Margin="0,0,4,0" ToolTip="{Binding Translation.IslandManagementEditIslandTooltip, FallbackValue='Edit selected island'}"
                        Background="Transparent" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.IsIslandSelected, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <fa5:ImageAwesome Icon="Solid_Pen" Width="11" Height="11"
                                      Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                </Button>

                <!-- Reset slot assignments -->
                <Button x:Name="ResetSlotsButton"
                        Click="ResetSlotsButton_Click"
                        Height="28" Width="28" Padding="0" Margin="0,0,4,0"
                        ToolTip="{Binding Translation.IslandManagementResetSlotsTooltip, FallbackValue='Reset slot assignments — re-enter the island to remap plots'}"
                        Background="Transparent" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.IsIslandSelected, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <fa5:ImageAwesome Icon="Solid_SyncAlt" Width="11" Height="11"
                                      Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                </Button>
            </StackPanel>

            <!-- Island live summary -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">
                <fa5:ImageAwesome Icon="Solid_Seedling"
                                  Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"
                                  Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding IslandBindings.LiveSummarySegments, FallbackValue={x:Null}}"
                              ItemTemplate="{StaticResource Island.LiveSummary.Segment.Template}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Separator Width="1" Background="{StaticResource SolidColorBrush.Background.4}" Margin="8,8" VerticalAlignment="Stretch"/>
                <fa5:ImageAwesome Icon="Solid_Home"
                                  Foreground="{StaticResource SolidColorBrush.Text.4}"
                                  Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="IslandBindings.Islands.Count" StringFormat="{}{0} islands tracked" FallbackValue="4 islands tracked"/>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock.Text>
                        <Binding Path="IslandBindings.GlobalHandlingTimeStatusText" StringFormat=" · {0}" FallbackValue=""/>
                    </TextBlock.Text>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.GlobalHandlingTimeStatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="3" Background="{StaticResource SolidColorBrush.Background.4}" Width="1" Margin="0,6"/>

            <!-- Settings toggle -->
            <Button Grid.Column="4"
                    x:Name="ToggleSettingsPanelButton"
                    Click="ToggleSettingsPanel_Click"
                    Height="28" Width="28" Margin="4,0"
                    Padding="0" ToolTip="{Binding Translation.IslandManagementSettingsTooltip, FallbackValue='Island Management Settings'}"
                    Background="Transparent" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IslandBindings.IsSettingsPanelOpen, FallbackValue=False}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.4}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.4}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <fa5:ImageAwesome Icon="Solid_SlidersH"
                                  Width="12" Height="12">
                    <fa5:ImageAwesome.Style>
                        <Style TargetType="{x:Type fa5:ImageAwesome}">
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.3}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.IsSettingsPanelOpen, FallbackValue=False}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fa5:ImageAwesome.Style>
                </fa5:ImageAwesome>
            </Button>
        </Grid>

        <!-- ======================================================= -->
        <!-- Settings slide-down overlay (Row 1 separator area + ZIndex over Row 2) -->
        <!-- Sits on top of the separator+content, anchored below toolbar -->
        <!-- ======================================================= -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IslandBindings.IsSettingsPanelOpen, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{StaticResource SolidColorBrush.Background.1}"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid Margin="16,12,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Display settings -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Translation.IslandManagementSettingsDisplay, FallbackValue=DISPLAY}" Style="{StaticResource Island.Section.Header}" Margin="0,0,0,8"/>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.ShowIslandCityColors, Mode=TwoWay, FallbackValue=True}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsCityIconLabel, FallbackValue='City icon &amp; name'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsCityIconDesc, FallbackValue='Show city icon and name on island cards'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.ShowIslandBiome, Mode=TwoWay, FallbackValue=True}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsBiomeLabel, FallbackValue=Biome}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsBiomeDesc, FallbackValue='Show biome on island cards'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.ShowTier, Mode=TwoWay, FallbackValue=True}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsShowTierLabel, FallbackValue='Tier badge'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsShowTierDesc, FallbackValue='Show tier badge on island cards'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.ShowPremium, Mode=TwoWay, FallbackValue=True}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsShowPremiumLabel, FallbackValue='Premium icon'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsShowPremiumDesc, FallbackValue='Show premium star icon on island cards'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- Col 1: Automation settings -->
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Translation.IslandManagementSettingsAutomation, FallbackValue=AUTOMATION}" Style="{StaticResource Island.Section.Header}" Margin="0,0,0,8"/>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.AutoSelectIslandByMapChange, Mode=TwoWay, FallbackValue=False}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoSelectLabel, FallbackValue='Auto-select island on map change'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoSelectDesc, FallbackValue='Selects island when you enter its map'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.AutoStartCycleOnIslandActivity, Mode=TwoWay, FallbackValue=False}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoCycleLabel, FallbackValue='Auto-start cycle on island activity'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoCycleDesc, FallbackValue='Begins tracking when laborer activity detected'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.AutoPrefillPayouts, Mode=TwoWay, FallbackValue=False}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoPrefillPayoutsLabel, FallbackValue='Auto-prefill payouts on cycle start'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsAutoPrefillPayoutsDesc, FallbackValue='Adds a finance record when an island transitions from Ready to planted'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsVisitDurationLabel, FallbackValue='Default visit duration (min)'}" Style="{StaticResource Island.Settings.Label}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementSettingsVisitDurationDesc, FallbackValue='Time to handle one island. Per-island override available in edit dialog.'}" Style="{StaticResource Island.Settings.SubLabel}"/>
                            </StackPanel>
                            <TextBox Text="{Binding IslandBindings.Preferences.DefaultVisitDurationMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="48" Height="22" FontSize="11" VerticalContentAlignment="Center" Padding="4,0"
                                     HorizontalAlignment="Right"
                                     Background="{StaticResource SolidColorBrush.Background.2}"
                                     Foreground="{StaticResource SolidColorBrush.Text.1}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Col 2: Sections visibility -->
                    <StackPanel Grid.Column="2" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Translation.IslandManagementSettingsVisibleSections, FallbackValue='VISIBLE SECTIONS'}" Style="{StaticResource Island.Section.Header}" Margin="0,0,0,8"/>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IslandBindings.Preferences.ShowNotesSection, Mode=TwoWay, FallbackValue=True}"
                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock Text="{Binding Translation.IslandManagementSettingsNotesSection, FallbackValue='Notes section'}" Style="{StaticResource Island.Settings.Label}"/>
                        </DockPanel>

                    </StackPanel>

                    <!-- Col 3: Sort & Group -->
                    <StackPanel Grid.Column="3" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Translation.IslandManagementSettingsSortGroup, FallbackValue='SORT &amp; GROUP'}" Style="{StaticResource Island.Section.Header}" Margin="0,0,0,8"/>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <TextBlock Text="{Binding Translation.IslandManagementSettingsGroupBy, FallbackValue='Group by'}" Style="{StaticResource Island.Settings.Label}" DockPanel.Dock="Left" Width="80"/>
                            <ComboBox ItemsSource="{x:Static bindingModel:IslandBindings.AvailableGroupModes}"
                                      SelectedItem="{Binding DataContext.IslandBindings.SelectedGroupModeOption,
                                                              RelativeSource={RelativeSource AncestorType=UserControl},
                                                              Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Height="24" FontSize="11" MinWidth="160"/>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Island.Settings.Row}">
                            <TextBlock Text="{Binding Translation.IslandManagementSettingsSortBy, FallbackValue='Sort by'}" Style="{StaticResource Island.Settings.Label}" DockPanel.Dock="Left" Width="80"/>
                            <ComboBox ItemsSource="{x:Static bindingModel:IslandBindings.AvailableSortModes}"
                                      SelectedItem="{Binding DataContext.IslandBindings.SelectedSortModeOption,
                                                              RelativeSource={RelativeSource AncestorType=UserControl},
                                                              Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Height="24" FontSize="11" MinWidth="160"/>
                        </DockPanel>

                        <TextBlock Text="{Binding Translation.IslandManagementSettingsDragHint, FallbackValue='Drag ≡ handles on cards to reorder'}"
                                   FontSize="10" Foreground="{StaticResource SolidColorBrush.Text.4}"
                                   TextWrapping="Wrap" MaxWidth="180" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IslandBindings.SortMode,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="{x:Static enumerations:IslandSortMode.Custom}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="4"
                            Click="ToggleSettingsPanel_Click"
                            Height="24" Width="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Top" ToolTip="{Binding Translation.IslandManagementCloseSettingsTooltip, FallbackValue='Close settings'}">
                        <fa5:ImageAwesome Icon="Solid_Times"
                                          Foreground="{StaticResource SolidColorBrush.Text.3}"
                                          Width="10" Height="10"/>
                    </Button>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Row 2: Separator -->
        <Separator Grid.Row="2" Background="{StaticResource SolidColorBrush.Background.3}" Height="4" VerticalAlignment="Stretch" Margin="0"/>

        <!-- ======================================================= -->
        <!-- Row 3: Main content -->
        <!-- ======================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IslandBindings.GridSplitterPosition, Mode=TwoWay, FallbackValue=220}" MinWidth="160" MaxWidth="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Col 0: Island list -->
            <ListBox x:Name="IslandListBox"
                     Grid.Column="0"
                     ItemsSource="{Binding IslandBindings.IslandsCollectionView, FallbackValue={x:Null}}"
                     SelectedItem="{Binding IslandBindings.SelectedIsland, Mode=TwoWay}"
                     ItemTemplate="{StaticResource Island.Card.Template}"
                     SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     AllowDrop="True"
                     Drop="IslandListBox_Drop">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                        BorderThickness="0,0,0,1" Padding="6,4,6,4" Margin="0,2,0,0"
                                        Background="{StaticResource SolidColorBrush.Background.2}">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border Background="Transparent" IsHitTestVisible="True">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Col 1: GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource SolidColorBrush.Accent.Blue.4}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Col 2: Detail panel -->
            <Grid Grid.Column="2">

                <!-- No island selected placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.IsIslandSelected, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <fa5:ImageAwesome Icon="Solid_Home"
                                      Foreground="{StaticResource SolidColorBrush.Text.4}"
                                      Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Translation.IslandManagementSelectAnIsland, FallbackValue='Select an island from the list'}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SolidColorBrush.Text.4}"
                               FontSize="14" FontStyle="Italic"/>
                    <TextBlock Text="{Binding Translation.IslandManagementSelectAnIslandHint, FallbackValue='or click + Add Island to get started'}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SolidColorBrush.Text.4}"
                               FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Detail TabControl -->
                <TabControl Margin="0" Background="Transparent" BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource SolidColorBrush.Background.3}"
                            Foreground="{StaticResource SolidColorBrush.Text.1}">
                    <TabControl.Style>
                        <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.IsIslandSelected, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>

                    <!-- ==================== Tab 1: Overview ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_ThLarge" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementOverview, FallbackValue=Overview}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,10,12,10">

                                <!-- Stat cards row -->
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementTier, FallbackValue=Tier}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.TierDisplay, FallbackValue='T5'}"
                                                       Style="{StaticResource Island.Stat.Value}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementCity, FallbackValue=City}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.CityName, FallbackValue='Bridgewatch'}"
                                                       Style="{StaticResource Island.Stat.Value}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementBiome, FallbackValue=Biome}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.Biome, FallbackValue='Forest'}"
                                                       Style="{StaticResource Island.Stat.Value}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementOwner, FallbackValue=Owner}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.OwnerName, FallbackValue='MyChar'}"
                                                       Style="{StaticResource Island.Stat.Value}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementPlots, FallbackValue=Plots}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.PlotCount, FallbackValue='12'}"
                                                       Style="{StaticResource Island.Stat.Value}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementPremium, FallbackValue=Premium}" Style="{StaticResource Island.Stat.Label}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <fa5:ImageAwesome Icon="Solid_Star"
                                                                  Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                                                  Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                  Visibility="{Binding IslandBindings.SelectedIsland.HasPremium,
                                                                               Converter={StaticResource BooleanToVisibilityConverter},
                                                                               FallbackValue=Visible}"/>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Island.Stat.Value}">
                                                            <Setter Property="Text" Value="{Binding Translation.IslandManagementPremiumInactive, FallbackValue=Inactive}"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.HasPremium, FallbackValue=True}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding Translation.IslandManagementPremiumActive, FallbackValue=Active}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementLaborersSent, FallbackValue='Laborers Sent'}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.TotalLaborersSent, FallbackValue='128'}"
                                                       Style="{StaticResource Island.Stat.Value.Positive}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Island.Stat.Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementLootCollected, FallbackValue='Loot Collected'}" Style="{StaticResource Island.Stat.Label}"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.TotalLootCollected, FallbackValue='47'}"
                                                       Style="{StaticResource Island.Stat.Value.Positive}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Collection status -->
                                <Border Background="{StaticResource SolidColorBrush.Background.2}"
                                        BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                        BorderThickness="1" CornerRadius="1"
                                        Padding="10,6" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <fa5:ImageAwesome Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <fa5:ImageAwesome.Style>
                                                    <Style TargetType="{x:Type fa5:ImageAwesome}">
                                                        <Setter Property="Icon" Value="Solid_Hourglass"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.CollectionStatusState}" Value="ready">
                                                                <Setter Property="Icon" Value="Solid_CheckCircle"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.CollectionStatusState}" Value="unknown">
                                                                <Setter Property="Icon" Value="Solid_QuestionCircle"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fa5:ImageAwesome.Style>
                                            </fa5:ImageAwesome>
                                            <TextBlock Text="{Binding Translation.IslandManagementStatus, FallbackValue='Status:'}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedIsland.CollectionStatusText, FallbackValue='Ready to Collect'}"
                                                       FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.CollectionStatusState}" Value="ready">
                                                                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <fa5:ImageAwesome Icon="Regular_Clock" Width="11" Height="11"
                                                              Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                              Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11">
                                                <TextBlock.Text>
                                                    <Binding Path="IslandBindings.SelectedIsland.LastVisited"
                                                             StringFormat="Last visit: {0:MMM d, HH:mm}"
                                                             FallbackValue="Last visit: —"
                                                             TargetNullValue="Last visit: —"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Notes section -->
                                <Border Background="{StaticResource SolidColorBrush.Background.2}"
                                        BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                        BorderThickness="1" CornerRadius="1"
                                        Padding="10,8" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IslandBindings.Preferences.ShowNotesSection, FallbackValue=True}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <fa5:ImageAwesome Icon="Solid_StickyNote" Width="11" Height="11"
                                                              Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Translation.IslandManagementNotes, FallbackValue=NOTES}" Style="{StaticResource Island.Section.Header}" Margin="0"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding IslandBindings.SelectedIsland.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                 MinHeight="50" MaxHeight="80" TextWrapping="Wrap"
                                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource SolidColorBrush.Background.1}"
                                                 FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.1}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Plant All -->
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Height="26" Padding="14,0" HorizontalAlignment="Right"
                                            Click="PlantAllButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_Seedling" Width="10" Height="10" Margin="0,0,5,0"
                                                              Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                            <TextBlock Text="{Binding Translation.IslandManagementPlantAll, FallbackValue='Plant All'}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================== Tab 2: Plots ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Map" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="Plots"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="{Binding IslandBindings.PlotDetailPanelHeight, Mode=TwoWay, FallbackValue=0}"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar: legend left, Add Plot right -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6"
                                       Visibility="{Binding IslandBindings.IsIslandSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <Button DockPanel.Dock="Right" Height="24" Padding="8,0" Click="AddPlotButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:ImageAwesome Icon="Solid_Plus" Width="9" Height="9" Margin="0,0,4,0"
                                                          Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                        <TextBlock Text="{Binding Translation.IslandManagementAddPlot, FallbackValue='Add Plot'}" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.1}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SolidColorBrush.Accent.Green.3}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Translation.IslandManagementLegendOnJob, FallbackValue='On Job'}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SolidColorBrush.Accent.Yellow.1}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Translation.IslandManagementLegendLootReady, FallbackValue='Loot Ready'}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SolidColorBrush.Text.4}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Translation.IslandManagementLegendHome, FallbackValue=Home}" Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Plot cards with faded island map background (PNG + slot overlay) -->
                            <Grid Grid.Row="1" ClipToBounds="True">
                                <!-- Layer 1: island PNG, uniform-fill, faded -->
                                <Viewbox Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.12">
                                    <Image x:Name="PlotsMapImage"
                                           Width="1024" Height="1024"
                                           Stretch="Fill"/>
                                </Viewbox>
                                <!-- Layer 2: slot status circles (same 1024×1024 space), faded -->
                                <Viewbox Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.35">
                                    <Canvas x:Name="PlotsMapOverlayCanvas" Width="1024" Height="1024"/>
                                </Viewbox>
                                <!-- Layer 3: plot cards (scrollable) -->
                                <vwp:VirtualizingItemsControl x:Name="PlotsItemsControl"
                                              ItemsSource="{Binding IslandBindings.SelectedIsland.Plots, FallbackValue={x:Null}}"
                                              ItemTemplate="{StaticResource Island.Plot.Template}"
                                              VirtualizingPanel.CacheLengthUnit="Item"
                                              VirtualizingPanel.CacheLength="5,5"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Standard"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                    <vwp:VirtualizingItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </vwp:VirtualizingItemsControl.ItemsPanel>
                                </vwp:VirtualizingItemsControl>
                            </Grid>

                            <!-- Drag handle / splitter -->
                            <GridSplitter Grid.Row="2"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          HorizontalAlignment="Stretch"
                                          Background="{StaticResource SolidColorBrush.Accent.Blue.4}"
                                          Visibility="{Binding IslandBindings.IsPlotSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                            <!-- Plot detail panel -->
                            <Border Grid.Row="3"
                                    Background="{StaticResource SolidColorBrush.Background.2}"
                                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{Binding IslandBindings.IsPlotSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="10,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Header row: plot title + close + delete -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <fa5:ImageAwesome Width="11" Height="11"
                                                              Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                                              Margin="0,0,6,0" VerticalAlignment="Center">
                                                <fa5:ImageAwesome.Style>
                                                    <Style TargetType="fa5:ImageAwesome">
                                                        <Setter Property="Icon" Value="Solid_Home"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.IsHouse}" Value="False">
                                                                <Setter Property="Icon" Value="Solid_Seedling"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fa5:ImageAwesome.Style>
                                            </fa5:ImageAwesome>
                                            <TextBlock Text="{Binding IslandBindings.SelectedPlot.PlotType, FallbackValue='Plot'}"
                                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedPlot.Quantity, StringFormat=' x{0}', FallbackValue=''}"
                                                       Visibility="{Binding IslandBindings.SelectedPlot.ShowQuantity, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                       FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <Button Height="24" Padding="8,0" Margin="0,0,6,0"
                                                    Click="EditPlotInline_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa5:ImageAwesome Icon="Solid_Edit" Width="9" Height="9" Margin="0,0,4,0"
                                                                      Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                                    <TextBlock Text="{Binding Translation.IslandManagementEditPlot, FallbackValue=Edit}" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.1}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Height="24" Padding="8,0"
                                                    Click="DeletePlotButton_Click"
                                                    Style="{StaticResource Style.Button.Danger}">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa5:ImageAwesome Icon="Solid_Trash" Width="9" Height="9" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Translation.IslandManagementDeletePlot, FallbackValue='Delete Plot'}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Laborer rows: House plots only -->
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.IsHouse}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Translation.IslandManagementLaborers, FallbackValue=Laborers}" Foreground="{StaticResource SolidColorBrush.Text.3}"
                                                       FontSize="10" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer1IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Blue.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer1IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer1IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding IslandBindings.SelectedPlot.Laborer1Line, FallbackValue='—'}"
                                                           Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer2IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Blue.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer2IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer2IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding IslandBindings.SelectedPlot.Laborer2Line, FallbackValue='—'}"
                                                           Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer3IndicatorState}" Value="sent"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Blue.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer3IndicatorState}" Value="loot_ready"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Green.3}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.Laborer3IndicatorState}" Value="on_job"><Setter Property="Fill" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding IslandBindings.SelectedPlot.Laborer3Line, FallbackValue='—'}"
                                                           Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Farmable type row: non-House farmable plots -->
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.IsHouse}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                                      ToolTip="{Binding IslandBindings.SelectedPlot.FarmableCropTooltip}">
                                                    <!-- Seedling fallback: shown when no crop image -->
                                                    <fa5:ImageAwesome Icon="Solid_Seedling" Width="10" Height="10"
                                                                      Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Visibility="{Binding IslandBindings.SelectedPlot.HasNoCropIcon, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                                                    <!-- Actual crop image when available -->
                                                    <Image Width="16" Height="16"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding IslandBindings.SelectedPlot.HasCropIcon, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                           Source="{Binding IslandBindings.SelectedPlot.FarmableCropIcon}"/>
                                                </Grid>
                                                <TextBlock Foreground="{StaticResource SolidColorBrush.Text.2}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding IslandBindings.SelectedPlot.FarmableTypeLine}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IslandBindings.SelectedPlot.FarmableTypeLine}" Value="">
                                                                    <Setter Property="Text" Value="{Binding Translation.IslandManagementNoCropConfigured, FallbackValue='No crop configured'}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Collection cycle + notes -->
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <fa5:ImageAwesome Icon="Solid_Clock" Width="10" Height="10"
                                                              Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IslandBindings.SelectedPlotCollectionCycleText, FallbackValue=''}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                                                   Text="{Binding IslandBindings.SelectedPlot.PlotType, StringFormat='Notes: ', FallbackValue=''}"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ==================== Tab 3: Live Status ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Eye" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLiveStatus, FallbackValue='Live Status'}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="8,8,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <fa5:ImageAwesome Icon="Solid_InfoCircle" Width="11" Height="11"
                                                  Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLiveStatusHint, FallbackValue='Data updates when you visit your island in-game'}"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}"
                                           FontStyle="Italic" FontSize="11"/>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Style="{StaticResource LoadingIconGridStyle}"
                                  Visibility="{Binding IslandBindings.IsLiveDataLoading,
                                                       Converter={StaticResource BooleanToVisibilityConverter},
                                                       FallbackValue=Collapsed}"/>

                            <vwp:VirtualizingItemsControl Grid.Row="2"
                                          ItemsSource="{Binding IslandBindings.LiveLaborerActionRows, IsAsync=True, FallbackValue={x:Null}}"
                                          ItemTemplate="{StaticResource Island.LiveLaborer.ActionRow.Template}"
                                          VirtualizingPanel.CacheLengthUnit="Item"
                                          VirtualizingPanel.CacheLength="10,10"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"/>
                        </Grid>
                    </TabItem>

                    <!-- ==================== Tab 4: Yield ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_ChartBar" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementYield, FallbackValue=Yield}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Two-panel layout: Collected | Consumed -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Collected panel -->
                                <GroupBox Grid.Column="0">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_BoxOpen" Width="10" Height="10" Margin="0,0,5,0"
                                                              Foreground="{StaticResource SolidColorBrush.Accent.Green.3}"/>
                                            <TextBlock Text="{Binding Translation.IslandManagementYieldCollected, FallbackValue=Collected}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementYieldNoData, FallbackValue='No data yet — collect items on your island to start tracking.'}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                       FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.YieldItems.Count, FallbackValue=0}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding IslandBindings.SelectedIsland.YieldItems}"
                                                          ItemTemplate="{StaticResource IslandYieldItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </GroupBox>

                                <!-- Consumed panel -->
                                <GroupBox Grid.Column="2">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_MinusCircle" Width="10" Height="10" Margin="0,0,5,0"
                                                              Foreground="{StaticResource SolidColorBrush.Accent.Red.3}"/>
                                            <TextBlock Text="{Binding Translation.IslandManagementYieldConsumed, FallbackValue=Consumed}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="11"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation.IslandManagementYieldNoData, FallbackValue='No data yet.'}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.4}"
                                                       FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IslandBindings.SelectedIsland.ConsumedItems.Count, FallbackValue=0}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding IslandBindings.SelectedIsland.ConsumedItems}"
                                                          ItemTemplate="{StaticResource IslandConsumedItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>

                            <!-- Totals bar -->
                            <Border Grid.Row="1" Margin="0,6,0,0"
                                    Background="{StaticResource SolidColorBrush.Background.2}"
                                    BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                    BorderThickness="0,1,0,0" Padding="6,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Height="20" Padding="6,0" FontSize="10"
                                            Click="BtnClearIslandYield_Click"
                                            Foreground="{StaticResource SolidColorBrush.Accent.Red.3}">
                                        <TextBlock Text="{Binding Translation.IslandManagementYieldClear, FallbackValue='Clear Yield Data'}"/>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Translation.IslandManagementYieldCollectedValue, FallbackValue='Collected value: '}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                        <TextBlock Text="{Binding IslandBindings.SelectedIsland.TotalYieldValue, StringFormat='{}{0:N0}', FallbackValue='0'}"
                                                   Foreground="{StaticResource SolidColorBrush.Accent.Green.3}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text=" silver  |  " Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11"/>
                                        <TextBlock Text="{Binding Translation.IslandManagementYieldConsumedValue, FallbackValue='Consumed value: '}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="11"/>
                                        <TextBlock Text="{Binding IslandBindings.SelectedIsland.TotalConsumedValue, StringFormat='{}{0:N0}', FallbackValue='0'}"
                                                   Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text=" silver" Foreground="{StaticResource SolidColorBrush.Text.4}" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ==================== Tab 5: Laborers ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Briefcase" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLaborers, FallbackValue=Laborers}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <userControls:IslandLaborerView x:Name="IslandLaborerViewControl"/>
                    </TabItem>

                    <!-- ==================== Tab 6: Map ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_MapMarkedAlt" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementMap, FallbackValue=Map}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <userControls:IslandMapView x:Name="IslandMapViewControl"
                                                   DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </TabItem>

                    <!-- ==================== Tab 7: Ledger ==================== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Book" Width="10" Height="10" Margin="0,0,5,0"
                                                  Foreground="{StaticResource SolidColorBrush.Text.3}"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLedger, FallbackValue=Ledger}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Owner summary header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Translation.IslandManagementLedgerOwner, FallbackValue='Owner: '}" FontWeight="SemiBold"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                                <TextBlock Text="{Binding IslandBindings.SelectedIsland.OwnerName, FallbackValue=''}"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="12"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLedgerBalance, FallbackValue='  Balance: '}" Margin="12,0,0,0"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="12"/>
                                <TextBlock Text="{Binding IslandBindings.OwnerBalanceOwed, StringFormat=N0, FallbackValue='0'}"
                                           Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Translation.IslandManagementLedgerSilver, FallbackValue=' Silver'}"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}" FontSize="12"/>
                            </StackPanel>

                            <!-- Ledger DataGrid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding IslandBindings.CurrentIslandLedger}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Background="{StaticResource SolidColorBrush.Background.2}"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource SolidColorBrush.Background.4}"
                                      RowBackground="Transparent"
                                      FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding Type}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Islands"
                                                        Binding="{Binding IslandCount}"
                                                        Width="60"/>
                                    <DataGridTextColumn Header="Amount"
                                                        Binding="{Binding Amount, StringFormat=N0}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="Notes"
                                                        Binding="{Binding Notes}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Add cycle record form -->
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Translation.IslandManagementLedgerAmountLabel, FallbackValue='Amount:'}" VerticalAlignment="Center"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="CycleAmountBox"
                                         Text="{Binding IslandBindings.NewCycleAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="24" FontSize="11"
                                         Background="{StaticResource SolidColorBrush.Background.1}"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{x:Static bindingModel:IslandBindings.CycleRecordTypes}"
                                          SelectedItem="{Binding IslandBindings.NewCycleType, Mode=TwoWay}"
                                          Height="24" FontSize="11"
                                          Background="{StaticResource SolidColorBrush.Background.1}"/>
                                <TextBox Grid.Column="5" x:Name="CycleIslandCountBox"
                                         Text="{Binding IslandBindings.NewCycleIslandCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="24" FontSize="11" Width="50"
                                         Background="{StaticResource SolidColorBrush.Background.1}"
                                         ToolTip="{Binding Translation.IslandManagementLedgerIslandCountTooltip, FallbackValue='Island count'}"
                                         Visibility="{Binding IslandBindings.NewCycleShowIslandCount,
                                             Converter={StaticResource BooleanToVisibilityConverter},
                                             FallbackValue=Visible}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Translation.IslandManagementLedgerNotesLabel, FallbackValue='Notes:'}" VerticalAlignment="Center"
                                           Foreground="{StaticResource SolidColorBrush.Text.3}"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="7" x:Name="CycleNotesBox"
                                         Text="{Binding IslandBindings.NewCycleNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="24" FontSize="11"
                                         Background="{StaticResource SolidColorBrush.Background.1}"/>
                                <Button Grid.Column="9" Content="{Binding Translation.IslandManagementLedgerAddRecord, FallbackValue='Add Record'}"
                                        Height="26" FontSize="11" Padding="10,0"
                                        Click="AddCycleRecord_Click"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
