<UserControl x:Class="StatisticsAnalysisTool.UserControls.IslandMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="720">

    <Border Background="{StaticResource SolidColorBrush.Background.2}"
            BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="1"
            Margin="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Unassigned plots chip panel -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="140"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.Preferences.IsUnassignedPanelCollapsed}" Value="True">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <!-- Map area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Unassigned plots panel -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="0,0,1,0"
                    Padding="6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Translation.IslandManagementMapUnassigned, FallbackValue=Unassigned}"
                                   Foreground="{StaticResource SolidColorBrush.Text.4}"
                                   FontSize="11" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IslandBindings.Preferences.IsUnassignedPanelCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl x:Name="UnassignedPlotsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="PlotChip"
                                            Background="{Binding ChipBrush}"
                                            CornerRadius="4"
                                            Margin="2,2"
                                            Padding="6,3"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="PlotChip_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Island.PlotChip.Foreground.Brush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Toggle button — always visible on left edge of map area -->
            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IslandBindings.Preferences.IsUnassignedPanelCollapsed, Mode=TwoWay}"
                          Width="14" Height="40" Padding="0"
                          Background="{StaticResource SolidColorBrush.Background.3}"
                          BorderThickness="0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Panel.ZIndex="20"
                          ToolTip="{Binding Translation.IslandManagementMapToggleTooltip, FallbackValue='Toggle unassigned plots panel'}">
                <fa5:ImageAwesome>
                    <fa5:ImageAwesome.Style>
                        <Style TargetType="fa5:ImageAwesome">
                            <Setter Property="Icon" Value="Solid_ChevronLeft"/>
                            <Setter Property="Width" Value="7"/>
                            <Setter Property="Height" Value="7"/>
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslandBindings.Preferences.IsUnassignedPanelCollapsed}" Value="True">
                                    <Setter Property="Icon" Value="Solid_ChevronRight"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fa5:ImageAwesome.Style>
                </fa5:ImageAwesome>
            </ToggleButton>

            <!-- Map area -->
            <Grid Grid.Column="1">
                <!-- No-map placeholder -->
                <StackPanel x:Name="NoLayoutPlaceholder"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Visible">
                    <fa5:ImageAwesome Icon="Solid_MapMarkedAlt"
                                      Foreground="{StaticResource SolidColorBrush.Text.4}"
                                      Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Translation.IslandManagementMapNoMap, FallbackValue='No map available'}"
                               Foreground="{StaticResource SolidColorBrush.Text.4}"
                               FontSize="13" FontStyle="Italic" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Translation.IslandManagementMapSelectIsland, FallbackValue='Select an island to view its map'}"
                               Foreground="{StaticResource SolidColorBrush.Text.4}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Zoom controls -->
                <StackPanel x:Name="ZoomControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,4,0"
                            Panel.ZIndex="10"
                            Visibility="Collapsed">
                    <Button x:Name="ZoomOutButton" Content="−" Width="22" Height="22" FontSize="14"
                            Click="ZoomOutButton_Click" Margin="0,0,2,0"/>
                    <Button x:Name="ZoomResetButton" Content="1:1" Width="30" Height="22" FontSize="9"
                            Click="ZoomResetButton_Click" Margin="0,0,2,0"/>
                    <Button x:Name="ZoomInButton" Content="+" Width="22" Height="22" FontSize="14"
                            Click="ZoomInButton_Click"/>
                </StackPanel>

                <!-- Map canvas container — shown when island has a map -->
                <ScrollViewer x:Name="MapScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed"
                              PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                    <Viewbox x:Name="MapViewbox" Stretch="Uniform">
                        <!-- Fixed 1024×1024 coordinate space matching the PNG resolution -->
                        <Grid Width="1024" Height="1024"
                              AllowDrop="True"
                              Drop="MapGrid_Drop"
                              DragOver="MapGrid_DragOver">
                            <Image x:Name="MapImage" Stretch="Fill"/>
                            <Canvas x:Name="SlotCanvas" Width="1024" Height="1024"/>
                        </Grid>
                    </Viewbox>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
