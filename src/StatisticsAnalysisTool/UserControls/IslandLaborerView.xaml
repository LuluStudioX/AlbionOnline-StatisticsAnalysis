<UserControl x:Class="StatisticsAnalysisTool.UserControls.IslandLaborerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="720">

    <Border Background="{StaticResource SolidColorBrush.Background.2}"
            BorderBrush="{StaticResource SolidColorBrush.Background.4}" BorderThickness="1"
            Margin="8">
        <DockPanel>

            <!-- Header: summary chips + refresh button -->
            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,6">
                <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="&#x21BB;"
                        Width="24" Height="24" FontSize="14" Padding="0"
                        Click="RefreshButton_Click" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LootReadyChip" Background="{StaticResource Island.Status.LootReady.Brush}" CornerRadius="4"
                            Padding="6,2" Margin="0,0,6,0">
                        <TextBlock x:Name="LootReadyText" Text="0 Loot Ready"
                                   FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="OnJobChip" Background="{StaticResource Island.Status.OnJob.Brush}" CornerRadius="4"
                            Padding="6,2" Margin="0,0,6,0">
                        <TextBlock x:Name="OnJobText" Text="0 On Job"
                                   FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="HomeChip" Background="{StaticResource Island.Status.Home.Brush}" CornerRadius="4"
                            Padding="6,2">
                        <TextBlock x:Name="HomeText" Text="0 Home"
                                   FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- No laborers placeholder -->
            <StackPanel x:Name="NoLaborersPlaceholder"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        DockPanel.Dock="Top"
                        Visibility="Visible">
                <fa5:ImageAwesome Icon="Solid_Briefcase"
                                  Foreground="{StaticResource SolidColorBrush.Text.4}"
                                  Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="NoLaborersTitle" Text="No laborers detected"
                           Foreground="{StaticResource SolidColorBrush.Text.4}"
                           FontSize="13" FontStyle="Italic" HorizontalAlignment="Center"/>
                <TextBlock x:Name="NoLaborersHint" Text="Visit an island with laborers to populate this view"
                           Foreground="{StaticResource SolidColorBrush.Text.4}"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Laborers DataGrid -->
            <DataGrid x:Name="LaborersGrid"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      Visibility="Collapsed"
                      FontSize="11"
                      Background="{StaticResource SolidColorBrush.Background.2}"
                      Foreground="{StaticResource SolidColorBrush.Text.1}"
                      BorderThickness="0"
                      RowBackground="{StaticResource SolidColorBrush.Background.2}"
                      AlternatingRowBackground="{StaticResource SolidColorBrush.Background.3}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.3}"/>
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="120"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding LaborerType}" Width="90"/>
                    <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="40"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Dispatched" Binding="{Binding DispatchText}" Width="90"/>
                    <DataGridTextColumn Header="Returns In" Binding="{Binding ReturnsInText}" Width="80"/>
                    <DataGridTextColumn Header="Fame Fill" Binding="{Binding FameFillText}" Width="70"/>
                    <DataGridTextColumn Header="Sent By" Binding="{Binding SentBy}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Premium" Binding="{Binding HasPremium}" Width="65"/>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
